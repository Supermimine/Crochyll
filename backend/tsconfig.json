{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],

    "rootDir": "../",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "declaration": true,
    "sourceMap": true,

    "moduleResolution": "bundler",

    "paths": {
      "@core/*": ["../Core/*"]
    }
  },

  "include": [
    "src",
    "../Core"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}